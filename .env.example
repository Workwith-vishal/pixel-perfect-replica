# Proctoring media storage. Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real keys.

SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key: safe to ship to the browser, used for signed-URL reads.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Secret key: server-side only. Bypasses RLS. Never expose to the client.
SUPABASE_SECRET_KEY=sb_secret_your_key

# JWKS endpoint for verifying Supabase-issued JWTs.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
